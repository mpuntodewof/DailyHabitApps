# Copy this file to `.env` (gitignored) and fill in real values before running `docker compose up`.
# `.env` is gitignored — do NOT commit secrets.

# Required: SQL Server SA password. Must satisfy SQL Server's password policy
# (>=8 chars, mix of upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=ChangeMe-StrongPassword!1

# Required: JWT signing key. ≥64 random bytes, base64.
# Generate with:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace-me-with-a-fresh-random-base64-string
JWT_ISSUER=DailyHabitTracker
JWT_AUDIENCE=DailyHabitTracker.Client

# Optional: SMTP for password reset emails. Use a Gmail App Password (no spaces).
# Without these the API still starts; forgot-password will return a clear error.
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: where reset-password links point (the SPA URL).
APP_WEB_BASE_URL=http://localhost:5173

# Optional: SPA -> API base URL baked into the SPA build.
VITE_API_URL=http://localhost:5198/api
